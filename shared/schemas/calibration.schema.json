{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CalibrationRecord",
  "description": "Stored calibration record for 5 fingers",
  "type": "object",
  "required": ["id", "captured_at", "fingers", "min_span_threshold", "status"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "patient_id": { "type": "string" },
    "device_id": { "type": "string" },
    "captured_at": { "type": "string", "format": "date-time" },
    "min_span_threshold": { "type": "integer", "default": 300 },
    "fingers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finger_index", "name", "open_value", "closed_value", "span", "polarity", "is_valid", "open_sd", "closed_sd"],
        "properties": {
          "finger_index": { "type": "integer", "minimum": 0, "maximum": 4 },
          "name": { "type": "string", "enum": ["thumb", "index", "middle", "ring", "pinky"] },
          "open_value": { "type": "number" },
          "closed_value": { "type": "number" },
          "span": { "type": "number" },
          "polarity": { "type": "integer", "enum": [-1, 1] },
          "is_valid": { "type": "boolean" },
          "reject_reason": { "type": ["string", "null"] },
          "open_sd": { "type": "number" },
          "closed_sd": { "type": "number" }
        }
      },
      "minItems": 5,
      "maxItems": 5
    },
    "status": { "type": "string", "enum": ["valid", "invalid", "drift_warning"] }
  },
  "additionalProperties": false
}

