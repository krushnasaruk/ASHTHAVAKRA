{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProtocolV1Commands",
  "description": "RehabBridge NEXUS / H10 Host-to-Device commands and acknowledgements schema",
  "definitions": {
    "ping_command": {
      "type": "object",
      "required": ["cmd", "id"],
      "properties": {
        "cmd": { "type": "string", "const": "ping" },
        "id": { "type": "string" }
      }
    },
    "ping_ack": {
      "type": "object",
      "required": ["ack", "ok", "fw", "profile"],
      "properties": {
        "ack": { "type": "string" },
        "ok": { "type": "boolean" },
        "fw": { "type": "string" },
        "profile": { "type": "string", "enum": ["demo3", "full5"] }
      }
    },
    "boot_line": {
      "type": "object",
      "required": ["boot", "fw", "profile"],
      "properties": {
        "boot": { "type": "boolean", "const": true },
        "fw": { "type": "string" },
        "profile": { "type": "string", "enum": ["demo3", "full5"] }
      }
    }
  }
}
